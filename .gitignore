# 密钥：绝不入库
.env
.secrets/

# 数据集：可再下载的大件不进仓库（见 README 许可一节）
data/cache/
data/web/
packages/core/data/cache/

# 原始史料：纯下载产物，可由 fetch 脚本重取
data/raw/*.html
data/raw/*.htm

# —— 但下面这些是「源数据」，必须入库，否则 clone 下来唐/宋两个题材直接是空的 ——
# 注意：父目录一旦整体排除，用 ! 也捞不回来，所以这里必须写成 data/processed/* 逐文件放行。
data/raw/*
!data/raw/juan*.json

data/processed/*
# 《新唐书·方镇表》州县隶属衍生表 + 手写 _display/_footer 覆盖层：没有它唐题材渲染不出来
!data/processed/tang_fanzhen_timeline.json
# 州治坐标表与州名词典：build_dynasty_map.py 直接读
!data/processed/tang_zhou_gazetteer.json
!data/processed/tang_zhou_dict.json
# 单元坐标表（手工整理或 new_topic.py 生成）—— 没有任何脚本能凭空造出坐标，
# 丢了题材就废了。注意 `*_gazetteer.json` 不会匹配 `*_gazetteer_checked.json`（中间产物）。
!data/processed/*_gazetteer.json
# 单元多边形表（new_topic.py 从 geoBoundaries 裁出来的，体积小、可作源数据）
!data/processed/*_units.geojson
# 已经算好的逐年几何。不带上它，clone 后唐宋的 dates() 返回空、点开是空白页。
# 改了 data/control/ 里的控制表后，记得重跑：
#   python src/build_dynasty_map.py --topic <id> --all-years --force
# 然后一起提交（服务启动时会自检并提示哪些年份的图过期了）。
!data/processed/*_map.geojson

# 运行输出（体积大、可重建）
output/
*-report.txt
parse-report.txt
ops-report.txt
state-report.txt

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 说明：site/assets/ 里的演示图**要入库** —— 它是项目门面，
# clone 下来就该能直接打开 site/index.html 看到效果。
# 这些渲染结果是本项目自己的产物，数据源许可（PDDL / CC BY）都允许再分发。

# 调试输出（早期手工排查留下的 txt）
*.txt
# 但依赖清单必须入库：它是「clone 下来就能跑」的一环，
# 被上面那条 *.txt 顺手吃掉的话，双击启动脚本会在第一步就找不到文件。
!requirements.txt


# 手工取景/自查用的临时渲染输出（本地产物，不入库）
out/
