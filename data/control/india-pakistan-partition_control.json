 "_era": {
  "1946": "英属印度尚未分治，现代印度、巴基斯坦与孟加拉地区同处殖民统治之下。",
  "1949": "印巴分治后，印度与巴基斯坦分别控制大部；东孟加拉属巴基斯坦，果阿与本地治里仍为葡法据点。",
  "1961": "印度收回果阿、达曼和第乌，本地治里已并入，南亚政治地图进一步整合。",
  "1972": "孟加拉国正式成立，东巴基斯坦从巴基斯坦分离。",
  "1975": "锡金公投后并入印度，成为印度第22个邦。"
 }
