 "_era": {
  "874": "乾符元年，关东饥荒，王仙芝起于长垣，唐廷仍号令诸镇。",
  "875": "乾符二年，黄巢响应王仙芝，义军转战曹濮，唐廷失淄青治所。",
  "876": "乾符三年，义军攻汝州，东都震动，忠武一带失控。",
  "877": "乾符四年，王仙芝、黄巢分兵，淮南、感化告急。",
  "878": "乾符五年，王仙芝败死，黄巢统军南下，入浙东、福建。",
  "879": "乾符六年，黄巢攻占广州，岭南、桂管入其手。",
  "880": "广明元年，黄巢自岭南北上，破潭州、江陵，江表震动。",
  "881": "广明元年冬，黄巢入洛阳、长安，称大齐皇帝。",
  "882": "中和二年，唐借沙陀诸军反攻，关中以外多复。",
  "883": "中和三年，黄巢退出长安，东走围陈州。",
  "884": "中和四年，黄巢败亡，秦宗权据蔡州。",
  "885": "中和五年，僖宗还京，秦宗权割据河南。"
 }
